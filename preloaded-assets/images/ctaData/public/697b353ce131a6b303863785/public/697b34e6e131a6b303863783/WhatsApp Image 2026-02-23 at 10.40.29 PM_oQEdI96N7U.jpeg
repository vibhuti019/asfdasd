const [isExpanded, setIsExpanded] = useState(false);

export default function ProductCard({ data, props }) {
  const { name = "Premium Headphones", price = "299.99", image = "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500&q=80" } = props || {};

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      whileHover={{ scale: 1.05 }}
      className="rounded-xl shadow-lg overflow-hidden"
    >
      <img src={{props.image}} className="w-full h-48 object-cover" />
      <CardContent className="p-4">
        <CardTitle>{{props.name}}</CardTitle>
        <Badge variant="secondary">{{props.price}}</Badge>
        <Button className="w-full mt-4" onClick={() => setIsExpanded(!isExpanded)}>
          View Details
        </Button>
      </CardContent>
    </motion.div>
  );
}